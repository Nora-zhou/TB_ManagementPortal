# ── RPA 加密主密钥 ────────────────────────────────────────────
# 用于加密数据库中保存的平台账号密码 / Cookie（AES-128 via Fernet）
# ⚠️ 一旦丢失，所有已加密的账号密码将无法解密，请妥善备份此文件
# 生成方式： python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RPA_MASTER_KEY=<在此填入你自己生成的 Fernet Key，勿提交真实值>

# ── RPA 浏览器配置 ────────────────────────────────────────────
# 是否无头模式（false = 显示浏览器窗口，出现滑块/短信验证时便于人工处理）
RPA_HEADLESS=false
# 浏览器用户数据目录（保留登录态，避免每次重新登录）
RPA_BROWSER_DATA_DIR=./browser_data
# Playwright 驱动的 Chromium 路径（留空则使用默认安装路径）
RPA_CHROMIUM_PATH=
# 浏览器模式：
#   isolated = 每个账号独立 profile（默认，登录态互不污染）
#   system   = 直接用系统 Edge/Chrome 的真实 profile，复用日常浏览器的登录态；
#              需先完全关闭该浏览器，否则 profile 被占用会启动失败
#   cdp      = 连接已经打开的浏览器（先运行项目根目录 start-browser-debug.bat），
#              直接驱动当前浏览器、复用其登录态，不开无缓存新窗口
RPA_BROWSER_MODE=isolated
# cdp 模式：浏览器远程调试地址（start-browser-debug.bat 默认使用 9222）
RPA_CDP_ENDPOINT=http://127.0.0.1:9222
# system 模式：系统浏览器用户数据目录（留空自动探测 Edge → Chrome）
RPA_SYSTEM_PROFILE_DIR=
# system 模式：Playwright channel（msedge / chrome，留空自动探测）
RPA_BROWSER_CHANNEL=
# 单次任务允许的最大时长（秒）
RPA_TASK_TIMEOUT=600
# 操作之间的随机延迟区间（秒），用于降低风控风险
RPA_DELAY_MIN=1.0
RPA_DELAY_MAX=2.5
# 人工验证（滑块/短信）等待时长（秒），超时后任务标记为 need_verify
RPA_VERIFY_TIMEOUT=300
# 抓取结果截图保存目录
RPA_SCREENSHOT_DIR=./rpa_screenshots

# ── 调试 ──────────────────────────────────────────────────────
# true = RPA 每个步骤都会保存截图到 RPA_SCREENSHOT_DIR
RPA_DEBUG_SCREENSHOT=false

# ── 千牛网页版页面直链（可选） ─────────────────────────────────
# 千牛工作台（work.taobao.com）是登录后渲染的 SPA，财务 / 交易子页面 URL 不固定。
# 建议：首次手动登录工作台后，从浏览器地址栏复制真实 URL 填到此处，之后 RPA 直链打开；
# 留空则 RPA 会尝试进入工作台首页后点击左侧导航菜单（财务 / 交易）。
RPA_QIANNIU_FINANCE_URL=
RPA_QIANNIU_TRADE_URL=
